{
  "expo": {
    "name": "Halcyon-contabil",
    "slug": "halcyon-contabil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "halcyon-contabil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.halcyontech.halcyoncontabil",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.halcyontech.halcyoncontabil",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#130B05"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
