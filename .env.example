# Copy to .env and fill in. Never commit .env.
# The agent's model. Set ONE of the two keys.
# Option A: Claude API key
ANTHROPIC_API_KEY=
# Optional: Claude model (default: claude-haiku-5-5)
ANTHROPIC_MODEL=
# Option B: Vultr Serverless Inference (OpenAI-compatible, https://api.vultrinference.com/v1)
VULTR_INFERENCE_API_KEY=
# Optional: model name on Vultr (default: kimi-k2-instruct). It must support tool calling
VULTR_MODEL=
# Optional: force the provider (anthropic or vultr). Default: Vultr only when just its key is set
LLM_PROVIDER=
# Optional: when set, every API route but /health needs `Authorization: Bearer <token>`
DEMO_TOKEN=
# Optional: where state is kept (default: ./data locally, /data in Docker)
DATA_DIR=
PORT=3000
