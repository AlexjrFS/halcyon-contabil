# Copy to .env and fill in. Never commit .env.
# Claude API key (the agent's model)
ANTHROPIC_API_KEY=
# Optional: model for the agent (default: claude-haiku-5-5)
ANTHROPIC_MODEL=
# Optional: when set, every API route but /health needs `Authorization: Bearer <token>`
DEMO_TOKEN=
# Optional: where state is kept (default: ./data locally, /data in Docker)
DATA_DIR=
PORT=3000
